{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/experience",
      "destination": "/experience/index.html"
    },
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/publications",
      "destination": "/publications/index.html"
    },
    {
      "source": "/skills",
      "destination": "/skills/index.html"
    },
    {
      "source": "/social",
      "destination": "/social/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/resume",
      "destination": "/resume/index.html"
    },
    {
      "source": "/writing",
      "destination": "/writing/index.html"
    },
    {
      "source": "/projects/syncly",
      "destination": "/projects/syncly/index.html"
    },
    {
      "source": "/projects/glycanbench",
      "destination": "/projects/glycanbench/index.html"
    },
    {
      "source": "/writing/rest-and-real-time",
      "destination": "/writing/rest-and-real-time/index.html"
    },
    {
      "source": "/writing/interpreting-research-models",
      "destination": "/writing/interpreting-research-models/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' https:; connect-src 'self' https://vigneshwarancj-portfolio-backend.onrender.com https://api.emailjs.com https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(.*).(js|css|webp|jpg|jpeg|png|svg|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
