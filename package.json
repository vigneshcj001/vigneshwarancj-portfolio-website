{
  "name": "my_portfolio",
  "version": "1.0.0",
  "description": "my portfolio",
  "homepage": "https://github.com/vigneshcj001/vigneshwarancj-portfolio-website#readme",
  "bugs": {
    "url": "https://github.com/vigneshcj001/vigneshwarancj-portfolio-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigneshcj001/vigneshwarancj-portfolio-website.git"
  },
  "license": "ISC",
  "alias": {
    "@vercel/analytics/react": "@vercel/analytics/dist/react/index.js"
  },
  "author": "vigneshwaran",
  "scripts": {
    "start": "parcel index.html",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true,maxRetries:5,retryDelay:200})\"",
    "prebuild": "node scripts/sync-portfolio-data.mjs && npm run clean",
    "build": "parcel build index.html --public-url / --no-cache --no-source-maps --cache-dir .parcel-build-cache && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/build.test.cjs tests/assistant.test.cjs",
    "test:browser": "node tests/browser.cjs && node tests/assistant.browser.cjs && node tests/architecture.browser.cjs",
    "test:all": "npm test && npm run test:browser",
    "resume:pdf": "node scripts/generate-resume.cjs"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.16.4",
    "@parcel/transformer-jsonld": "^2.16.4",
    "@parcel/transformer-webmanifest": "^2.16.4",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "buffer": "^6.0.3",
    "parcel": "^2.16.4",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "process": "^0.11.10",
    "tailwindcss": "^4.3.3",
    "wait-on": "^9.5.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@emailjs/browser": "^5.0.3",
    "@vercel/analytics": "^2.0.1",
    "framer-motion": "^14.3.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-icons": "^5.7.0",
    "react-router": "^7.18.4",
    "react-simple-typewriter": "^5.0.1"
  },
  "type": "module"
}
