  "bugs": {
    "url": "https://github.com/vigneshcj001/vigneshwarancj-portfolio-website/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vigneshcj001/vigneshwarancj-portfolio-website.git"
  },
  "license": "ISC",
  "alias": {
    "@vercel/analytics/react": "@vercel/analytics/dist/react/index.js"
  },
  "author": "vigneshwaran",
  "scripts": {
    "start": "parcel index.html",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prebuild": "npm run clean",
    "build": "parcel build index.html --public-url / --no-cache --no-source-maps && node scripts/postbuild.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node --test tests/build.test.cjs",
    "test:browser": "node tests/browser.cjs",
    "test:all": "npm test && npm run test:browser"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.15.4",
    "@parcel/transformer-jsonld": "^2.15.4",
    "@parcel/transformer-webmanifest": "^2.15.4",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "parcel": "^2.15.4",
    "playwright": "^1.63.0",
    "postcss": "^8.5.6",
    "process": "^0.11.10",
    "tailwindcss": "^4.1.12",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@vercel/analytics": "^1.5.0",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-router": "^7.17.0",
    "react-simple-typewriter": "^5.0.1"
  },
  "type": "module"
}
